--- a/common/objects-in-frame.h
+++ b/common/objects-in-frame.h
@@ -18,9 +18,35 @@ enum class object_type
 
 std::string object_type_to_string( object_type type );
 
+// Optional geometry for detectors that know more than an axis-aligned box -- e.g. the AprilTag
+// docking filter, which knows the tag's rotated quad and its 3D pose. All coordinates are
+// normalized [0,1] against the detection image, exactly like object_in_frame's bboxes, and are
+// unnormalized against the stream tile at draw time.
+//
+// Everything here defaults to "absent", and object_in_frame's constructor does not touch it, so
+// existing producers (openvino-face-detection, the OD pipeline) keep working unchanged and the
+// viewer falls back to the plain rectangle for them.
+struct object_geometry
+{
+    // Rotated quad, in the detector's own corner order (p[0]..p[3]). When present the viewer draws
+    // these four edges INSTEAD of the axis-aligned bounding box.
+    bool has_quad = false;
+    rs2::float2 quad[4] = {};
+
+    // Projected pose axes: the object origin plus the x/y/z axis endpoints, drawn red/green/blue.
+    // An axis whose 3D endpoint fell behind the camera (z <= 0) has axis_valid false and must be
+    // skipped -- its projected coordinates are meaningless.
+    bool has_axes = false;
+    rs2::float2 axis_origin = {};
+    rs2::float2 axis_end[3] = {};
+    bool axis_valid[3] = { false, false, false };
+};
+
+
 struct object_in_frame
 {
     rs2::rect normalized_color_bbox, normalized_depth_bbox;
+    object_geometry geometry;   // optional rotated quad / pose axes; empty unless a producer fills it in
     std::string name;
     float mean_depth;
     float metadata_depth;         // distance reported by the detection model (meters); 0 if unavailable
@@ -55,4 +81,11 @@ struct atomic_objects_in_frame : public objects_in_frame
     std::mutex mutex;
     bool sensor_is_on = true;
     int ticks_without_od_frame = 0;  // render ticks since last OD frame; cleared on every OD frame arrival
+
+    // True while the contents were produced by the object-detection (RS2_STREAM_OBJECT_DETECTION)
+    // pipeline. Post-processing filters -- e.g. the AprilTag docking filter -- publish into this
+    // same container, and viewer_model::process_object_detection_frames() must not expire what it
+    // did not produce; without this flag its stale-OD garbage collection wipes the filter's
+    // detections on every render tick, before render_2d_view() ever draws them.
+    bool od_produced = false;
 };
